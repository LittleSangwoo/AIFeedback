@@model ProcessingViewModel

@{
    ViewData["Title"] = "Обработка...";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status">
                <span class="sr-only">Загрузка...</span>
            </div>
            <h4 class="mt-3">Идёт обработка анкет...</h4>
            <p class="text-muted">Это займёт не более 15 минут.</p>
            <p><strong>Файл:</strong> @Model.FileName</p>
            <p><strong>Нейросеть:</strong> @Model.Provider</p>
            <div class="progress mt-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
            </div>
            <div id="statusMessage" class="mt-3">
                <span>Запуск анализа...</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Отправляем AJAX-запрос на реальную обработку
    // Предполагаем, что у нас есть скрытое поле с данными
    document.addEventListener('DOMContentLoaded', function () {
        // Подразумевается, что мы передаём файл через FormData,
        // но для простоты мы уже его загрузили и теперь вызываем ProcessFile.
        // Здесь можно использовать fetch для асинхронного опроса статуса.
        // Реализация зависит от архитектуры: можно использовать SignalR или периодический опрос.
        // Для демонстрации просто перенаправляем на Result через 5 секунд.
        setTimeout(function() {
            window.location.href = '/Feedback/Result';
        }, 5000);
    });
</script>