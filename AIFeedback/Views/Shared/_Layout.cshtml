<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – AIFeedback</title>
    
    <!-- Подключаем Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Подключаем иконки Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Глобальные стили для всего приложения (Тёмная тема) */
        body {
            background-color: #0f0f13 !important;
            color: #e0e0e0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        /* --- ПРЕМИАЛЬНЫЙ СТИЛЬ КНОПКИ "НАЗАД" --- */
        .btn-header-back {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 10px 32px; /* Сделали её шире */
            background: rgba(124, 77, 255, 0.08);
            border: 1px solid rgba(179, 136, 255, 0.25);
            color: #b388ff;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            text-decoration: none;
            backdrop-filter: blur(8px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-header-back:hover {
            background: rgba(124, 77, 255, 0.2);
            border-color: #b388ff;
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* --- МАГИЯ ДЛЯ ШАПКИ (Glassmorphism) --- */
        .navbar-custom {
            background-color: transparent;
            transition: all 0.4s ease;
        }
        
        .navbar-scrolled {
            background-color: rgba(15, 15, 19, 0.85) !important;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(124, 77, 255, 0.2);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            padding: 10px 0 !important;
        }
    </style>
</head>
<body>
    <nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark sticky-top navbar-custom py-3" style="z-index: 1050;">
        <!-- justify-content-between разнесет логотип влево, а кнопку вправо -->
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            
            <!-- Логотип слева -->
            <a class="navbar-brand fw-bold fs-4 m-0" asp-controller="Home" asp-action="Index" style="color: #b388ff; letter-spacing: 1px;">
                <i class="bi bi-robot me-2"></i>AIFeedback
            </a>

            <!-- Кнопка Назад справа -->
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
                
                bool isHomePage = (string.IsNullOrEmpty(controller) || string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)) 
                                  && (string.IsNullOrEmpty(action) || string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase));
            }

            @if (!isHomePage)
            {
                <a href="javascript:history.back()" class="btn-header-back">
                    <i class="bi bi-chevron-left"></i> Назад
                </a>
            }

        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Скрипт матового стекла при скролле -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navbar = document.getElementById("mainNavbar");
            
            window.addEventListener("scroll", function () {
                if (window.scrollY > 20) {
                    navbar.classList.add("navbar-scrolled");
                } else {
                    navbar.classList.remove("navbar-scrolled");
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>