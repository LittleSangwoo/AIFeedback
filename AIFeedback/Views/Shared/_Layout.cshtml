<!DOCTYPE html>
<html lang="ru">
<head>
    <script>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – AIFeedback</title>
   <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="~/favicon.ico" type="image/x-icon">


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            font-size: 1rem;
        }

        .navbar-custom {
            background-color: var(--navbar-bg, #ffffff);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border, #dce1e6);
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            padding: 14px 0;
            transition: all 0.3s ease;
        }

        .navbar-scrolled {
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            padding: 10px 0 !important;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .brand-title {
            color: var(--accent-color, #004d99);
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
            margin: 0;
        }
        .brand-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted, #6c757d);
            border-left: 2px solid var(--card-border);
            padding-left: 10px;
            margin-left: 4px;
        }

        .export-capsule {
            background: var(--card-bg, #ffffff);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        .export-label {
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            color: var(--text-color);
            padding: 0 18px;
            text-transform: uppercase;
            background: rgba(128, 128, 128, 0.08);
            align-self: stretch;
            display: flex;
            align-items: center;
        }

        .btn-премиум-export {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 22px;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            background: transparent;
            border: none;
            min-width: 105px;
        }

        .btn-export-excel { color: #198754; }
        .btn-export-excel:hover { background-color: rgba(25, 135, 84, 0.12); color: #157347; }

        .btn-export-word { color: #0d6efd; }
        .btn-export-word:hover { background-color: rgba(13, 110, 253, 0.12); color: #0b5ed7; }

        .btn-export-pdf { color: #dc3545; }
        .btn-export-pdf:hover { background-color: rgba(220, 53, 69, 0.12); color: #bb2d3b; }

        .export-divider {
            width: 1px;
            height: 22px;
            background-color: var(--card-border);
        }

        .utilities-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-utility {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 16px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            border: 1px solid var(--card-border);
            background: transparent;
            color: var(--text-color);
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-utility:hover {
            background: var(--export-btn-bg, rgba(0,0,0,0.03));
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .btn-header-back {
            background: rgba(124, 77, 255, 0.08);
            border-color: rgba(179, 136, 255, 0.3);
            color: var(--accent-color);
        }
        .btn-header-back:hover {
            background: rgba(124, 77, 255, 0.15);
            color: var(--text-color);
        }

        .btn-help {
            cursor: pointer;
        }

        .help-modal-content {
            background: var(--card-bg, #ffffff);
            color: var(--text-color);
            border: 1px solid var(--card-border);
            border-radius: 12px;
        }

        .help-modal-content .modal-header,
        .help-modal-content .modal-footer {
            border-color: var(--card-border);
        }

        .help-intro {
            color: var(--text-muted, #6c757d);
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .help-accordion .accordion-item {
            background: transparent;
            border: 1px solid var(--card-border);
            margin-bottom: 8px;
            border-radius: 8px !important;
            overflow: hidden;
        }

        .help-accordion .accordion-button {
            background: transparent;
            color: var(--text-color);
            font-weight: 600;
            font-size: 0.95rem;
            gap: 10px;
            box-shadow: none !important;
        }

        .help-accordion .accordion-button:not(.collapsed) {
            background: rgba(0, 77, 153, 0.06);
            color: var(--accent-color);
        }

        .help-accordion .accordion-button::after {
            filter: var(--icon-filter, none);
        }

        .help-accordion .accordion-body {
            font-size: 0.9rem;
            line-height: 1.6;
            color: var(--text-color);
            padding-top: 4px;
        }

        .help-accordion .accordion-body ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

        .help-accordion .accordion-body li {
            margin-bottom: 4px;
        }

        .help-section-icon {
            color: var(--accent-color, #004d99);
            font-size: 1rem;
            flex-shrink: 0;
        }

        .help-footer-note {
            font-size: 0.85rem;
            color: var(--text-muted, #6c757d);
            margin-right: auto;
        }

        .btn-help-support {
            background: var(--accent-color, #004d99);
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .btn-help-support:hover {
            opacity: 0.88;
            color: #fff;
        }

        @@media print {
            .navbar { display: none !important; }
        }
    </style>
</head>
<body>
    <nav id="mainNavbar" class="navbar navbar-expand-lg sticky-top navbar-custom">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            
            <!-- Логотип и контекст -->
            <div class="d-flex align-items-center">
                <a class="brand-container" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bar-chart-fill fs-3" style="color: var(--accent-color);"></i>
                    <div>
                        <h1 class="brand-title">AIFeedback</h1>
                    </div>
                </a>
                <span class="d-none d-md-inline brand-subtitle">Анализ образовательных программ</span>
            </div>

            <!-- Контекстные кнопки экспорта (Появляются ТОЛЬКО на странице графиков/дашборда) -->
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
                var id = ViewContext.RouteData.Values["id"]?.ToString();
                
                bool isDashboardDetails = string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase) 
                                       && string.Equals(action, "Details", StringComparison.OrdinalIgnoreCase);
            }

            <div class="d-none d-lg-flex align-items-center">
                @if (isDashboardDetails && !string.IsNullOrEmpty(id))
                {
                    <div class="export-capsule">
                        <span class="export-label">Экспорт</span>
                        <a href="@Url.Action("DownloadExcel", "Dashboard", new { id = id })" class="btn-премиум-export btn-export-excel" title="Скачать аналитическую справку в Excel">
                            <i class="bi bi-file-earmark-excel-fill"></i> Excel
                        </a>
                        <div class="export-divider"></div>
                        <a href="@Url.Action("DownloadWord", "Dashboard", new { id = id })" class="btn-премиум-export btn-export-word" title="Скачать аналитическую справку в Word">
                            <i class="bi bi-file-earmark-word-fill"></i> Word
                        </a>
                        <div class="export-divider"></div>
                        <button class="btn-премиум-export btn-export-pdf" onclick="window.print()" title="Сохранить дашборд в PDF">
                            <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                        </button>
                    </div>
                }
            </div>

            <!-- ЗОНА 3: Системные утилиты (Шлюзы, Справка, Тема, Назад) -->
            <div class="utilities-group">
                <a asp-controller="Settings" asp-action="Index" class="btn-utility">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M11.5 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM9.05 3a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0V3h9.05zM4.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM2.05 8a2.5 2.5 0 0 1 4.9 0H16v1H6.95a2.5 2.5 0 0 1-4.9 0H0V8h2.05zm9.45 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm-2.45 1a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0v-1h9.05z" />
                    </svg>
                    <span>Шлюзы ИИ</span>
                </a>

                <button type="button" class="btn-utility btn-help" data-bs-toggle="modal" data-bs-target="#helpModal" title="Справка по работе с системой">
                    <i class="bi bi-question-circle"></i>
                    <span>Справка</span>
                </button>

                <button id="themeToggle" class="btn-utility">
                    <i class="bi bi-moon-stars"></i>
                    <span>Тема</span>
                </button>

                @{
                    bool isHomePage = (string.IsNullOrEmpty(controller) || string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)) 
                                      && (string.IsNullOrEmpty(action) || string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase));
                }
                
                @if (!isHomePage)
                {
                    <a href="javascript:history.back()" class="btn-utility btn-header-back">
                        <i class="bi bi-arrow-left"></i>
                        <span>Назад</span>
                    </a>
                }
            </div>

        </div>
    </nav>

    <!-- МОДАЛЬНОЕ ОКНО: СПРАВОЧНЫЙ ЦЕНТР -->
    <div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content help-modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-question-circle-fill fs-4" style="color: var(--accent-color);"></i>
                        <h5 class="modal-title mb-0" id="helpModalLabel">Справочный центр AIFeedback</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <p class="help-intro">
                        Краткое руководство по работе с системой анализа образовательных программ.
                        Разделы ниже помогут быстро сориентироваться в интерфейсе — раскройте нужный пункт, чтобы увидеть подробности.
                    </p>

                    <div class="accordion help-accordion" id="helpAccordion">

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#help-about">
                                    <i class="bi bi-info-circle-fill help-section-icon"></i> О системе
                                </button>
                            </h2>
                            <div id="help-about" class="accordion-collapse collapse show" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    AIFeedback анализирует анкеты слушателей образовательных программ, загруженные в формате Excel.
                                    Система рассчитывает ключевые метрики (полезность, практика, доступность, взаимодействие, вовлечённость),
                                    передаёт данные модели ИИ для анализа тональности отзывов, выявления тем и формирования рекомендаций,
                                    а затем строит дашборд и позволяет выгрузить официальную аналитическую справку.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-upload">
                                    <i class="bi bi-upload help-section-icon"></i> Загрузка анкет и запуск анализа
                                </button>
                            </h2>
                            <div id="help-upload" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    На главной странице заполните форму загрузки:
                                    <ul>
                                        <li><strong>Основной файл выгрузки (Excel)</strong> — обязательное поле, результаты текущего потока программы, форматы .xlsx, .xls, .csv;</li>
                                        <li><strong>«Рассчитать тренд удовлетворённости»</strong> — переключатель, при включении открывает поле для загрузки файлов прошлых потоков; даты определяются автоматически по названиям файлов;</li>
                                        <li><strong>Вычислительная ИИ-модель</strong> — выбор провайдера из списка, настроенного в разделе «Шлюзы ИИ»;</li>
                                        <li>Нажмите «Сгенерировать аналитику» — обработка обычно занимает 5–15 секунд в зависимости от объёма файлов, после чего система автоматически откроет дашборд по загруженной программе.</li>
                                    </ul>
                                    Если связь с ИИ временно недоступна, дашборд всё равно будет построен — но без текстовых заключений ИИ, только на основе расчётных показателей.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-list">
                                    <i class="bi bi-list-ul help-section-icon"></i> Список программ
                                </button>
                            </h2>
                            <div id="help-list" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    Раздел «Дашборд» отображает список всех проанализированных программ с ключевыми показателями по каждой из них.
                                    Чтобы открыть подробную аналитику по конкретной программе, выберите её из списка.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-details">
                                    <i class="bi bi-bar-chart-fill help-section-icon"></i> Дашборд программы
                                </button>
                            </h2>
                            <div id="help-details" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    На странице конкретной программы доступны:
                                    <ul>
                                        <li>баллы по критериям (полезность, практика, доступность, взаимодействие);</li>
                                        <li>радарная диаграмма профиля программы;</li>
                                        <li>распределение оценок слушателей;</li>
                                        <li>график тренда удовлетворённости (появляется, если при загрузке были приложены исторические файлы);</li>
                                        <li>матрица корреляций между критериями;</li>
                                        <li>аналитическое заключение ИИ с приоритетными рекомендациями.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-chat">
                                    <i class="bi bi-chat-dots-fill help-section-icon"></i> Чат с ИИ-аналитиком
                                </button>
                            </h2>
                            <div id="help-chat" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    В нижней части дашборда программы можно задать уточняющий вопрос по отчёту — ИИ отвечает на основе уже сформированного анализа этой программы.
                                    Историю переписки можно сохранить в текстовый файл кнопкой «Сохранить чат (.txt)».
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-export">
                                    <i class="bi bi-download help-section-icon"></i> Экспорт отчётов
                                </button>
                            </h2>
                            <div id="help-export" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    На странице дашборда программы в шапке доступна панель экспорта:
                                    <ul>
                                        <li><strong>Excel</strong> — аналитическая справка в табличном виде со всеми показателями и заключениями ИИ;</li>
                                        <li><strong>Word</strong> — та же справка в текстовом формате, готовая к печати и согласованию;</li>
                                        <li><strong>PDF</strong> — сохранение текущего вида дашборда через диалог печати браузера.</li>
                                    </ul>
                                    Панель отображается только на странице конкретной программы, где есть данные для выгрузки.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-gateways">
                                    <i class="bi bi-gear-fill help-section-icon"></i> Шлюзы ИИ
                                </button>
                            </h2>
                            <div id="help-gateways" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    В разделе «Шлюзы ИИ» настраиваются провайдеры искусственного интеллекта, которые используются для анализа загружаемых анкет.
                                    Здесь можно добавить нового провайдера, изменить существующего или удалить ненужного.
                                    Добавленные провайдеры появляются в списке выбора модели на главной странице при загрузке файла —
                                    вносить изменения в этом разделе рекомендуется только ответственным сотрудникам.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-theme">
                                    <i class="bi bi-moon-stars-fill help-section-icon"></i> Оформление
                                </button>
                            </h2>
                            <div id="help-theme" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    Кнопка «Тема» в шапке переключает светлое и тёмное оформление интерфейса.
                                    Выбор сохраняется в браузере и применяется автоматически при следующих посещениях сайта.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help-faq">
                                    <i class="bi bi-patch-question-fill help-section-icon"></i> Частые вопросы
                                </button>
                            </h2>
                            <div id="help-faq" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    <strong>Не вижу кнопок экспорта.</strong> Они появляются только на странице дашборда конкретной программы.<br><br>
                                    <strong>Вижу предупреждение «Связь с нейросетью временно недоступна».</strong> Дашборд построен на основе расчётов, но без анализа ИИ — проверьте настройки в разделе «Шлюзы ИИ» либо повторите загрузку позже.<br><br>
                                    <strong>На дашборде не появляется график тренда.</strong> Он строится только при наличии более одного значения — включите переключатель «Рассчитать тренд удовлетворённости» и приложите файлы прошлых потоков при загрузке.<br><br>
                                    <strong>В списке ИИ-моделей не хватает нужного провайдера.</strong> Добавьте его в разделе «Шлюзы ИИ» — после сохранения он появится в списке на главной странице.<br><br>
                                    <strong>Нужно вернуться к предыдущей странице.</strong> Используйте кнопку «Назад» в шапке — она доступна на всех страницах, кроме главной.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                    
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-help-support px-5" data-bs-dismiss="modal">
                        Понятно, закрыть
                    </button>
                </div>
            </div>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navbar = document.getElementById("mainNavbar");
            window.addEventListener("scroll", function () {
                if (window.scrollY > 20) {
                    navbar.classList.add("navbar-scrolled");
                } else {
                    navbar.classList.remove("navbar-scrolled");
                }
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const themeBtn = document.getElementById('themeToggle');
            const span = themeBtn.querySelector('span');
            const icon = themeBtn.querySelector('i');
            
            if (document.documentElement.getAttribute('data-theme') === 'dark') {
                span.innerText = 'Светлая';
                icon.className = 'bi bi-sun-fill';
            } else {
                span.innerText = 'Темная';
                icon.className = 'bi bi-moon-stars-fill';
            }

            themeBtn.addEventListener('click', () => {
                let currentTheme = document.documentElement.getAttribute('data-theme');
                let newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                if (newTheme === 'light') {
                    span.innerText = 'Темная';
                    icon.className = 'bi bi-moon-stars-fill';
                } else {
                    span.innerText = 'Светлая';
                    icon.className = 'bi bi-sun-fill';
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>