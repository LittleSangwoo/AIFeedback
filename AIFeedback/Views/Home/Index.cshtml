@@model UploadViewModel

@{
    ViewData["Title"] = "Учебная аналитика";
}

<div class="container text-center mt-5">
    <h1 class="display-5 fw-bold">Аналитика образовательных программ</h1>
    <p class="lead">Загрузите выгрузку анкет (Excel), и ИИ-агент подготовит отчет за несколько секунд.</p>

    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <form asp-controller="Analyzer" asp-action="ProcessUpload" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <input class="form-control form-control-lg" type="file" id="uploadFile" name="uploadFile" accept=".xlsx, .xls, .csv" required>
                        </div>
                        <!-- КРИТЕРИЙ 4.1: Одна кнопка для старта -->
                        <button type="submit" class="btn btn-primary btn-lg w-100" id="analyzeBtn" onclick="showLoader()">
                            <i class="bi bi-magic"></i> Сгенерировать аналитику
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Лоадер, чтобы пользователь понимал, что идет ИИ-анализ -->
    <div id="loader" class="mt-4" style="display:none;">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">ИИ-агент анализирует тексты... Пожалуйста, подождите (до 15 сек).</p>
    </div>
</div>

<script>
    function showLoader() {
        if(document.getElementById('uploadFile').value) {
            document.getElementById('analyzeBtn').style.display = 'none';
            document.getElementById('loader').style.display = 'block';
        }
    }
</script>