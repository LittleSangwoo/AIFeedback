@model UploadViewModel

@{
    ViewData["Title"] = "Аналитика образовательных программ";
}

<style>
    /* Corporate Dark Theme: Official Enterprise Look */
    body {
        background-color: #0b0e14 !important;
        color: #c9d1d9 !important;
        font-family: 'Segoe UI', Tahoma, Helvetica, sans-serif;
    }

    .hero-title {
        color: #ffffff;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .official-card {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .form-label {
        color: #8b949e;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    /* Строгий стиль полей ввода */
    .form-control-dark {
        background-color: #0d1117;
        border: 1px solid #30363d;
        color: #c9d1d9;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .form-control-dark:focus {
        background-color: #0d1117;
        border-color: #58a6ff;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.15);
    }

    /* Кнопка "Обзор..." внутри инпута файла */
    .form-control-dark::file-selector-button {
        background-color: #21262d;
        color: #c9d1d9;
        border: none;
        border-right: 1px solid #30363d;
        padding: 0.6rem 1.2rem;
        margin-right: 1rem;
        font-weight: 500;
        transition: background-color 0.2s ease;
        cursor: pointer;
    }

    .form-control-dark::file-selector-button:hover {
        background-color: #30363d;
        color: #ffffff;
    }

    /* Селект (выпадающий список) */
    .form-select-dark {
        background-color: #0d1117;
        border: 1px solid #30363d;
        color: #c9d1d9;
        border-radius: 6px;
    }

    .form-select-dark:focus {
        background-color: #0d1117;
        border-color: #58a6ff;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.15);
    }

    /* Официальная кнопка отправки */
    .btn-official {
        background-color: #238636;
        color: #ffffff;
        border: 1px solid rgba(240, 246, 252, 0.1);
        font-weight: 600;
        border-radius: 6px;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
    }

    .btn-official:hover {
        background-color: #2ea043;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* Стили для тумблера (Switch) */
    .form-check-input {
        background-color: #21262d;
        border-color: #30363d;
        cursor: pointer;
    }
    .form-check-input:checked {
        background-color: #58a6ff;
        border-color: #58a6ff;
    }
    .form-check-label {
        cursor: pointer;
        color: #c9d1d9;
        font-weight: 500;
    }

    /* Блок мульти-загрузки для тренда */
    .trend-upload-box {
        background-color: #0d1117;
        border: 1px dashed #30363d;
        border-radius: 6px;
        padding: 20px;
        margin-top: 15px;
        display: none; /* Скрыт по умолчанию */
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .loader-spinner {
        color: #58a6ff;
    }
</style>

<div class="container text-center mt-5">
    <h1 class="display-5 hero-title mb-3">Аналитика образовательных программ</h1>
    <p class="text-secondary mb-5 fs-5">Загрузите данные выгрузки. ИИ-агент подготовит структурированный отчет.</p>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="official-card text-start">
                <div class="card-body p-4 p-md-5">
                    
                    <form asp-controller="Analyzer" asp-action="ProcessFile" method="post" enctype="multipart/form-data" id="uploadForm">
                        
                        <!-- 1. ОСНОВНОЙ ФАЙЛ -->
                        <div class="mb-4">
                            <label for="uploadFile" class="form-label">Основной файл выгрузки (Excel)</label>
                            <input class="form-control form-control-lg form-control-dark" type="file" id="uploadFile" name="uploadFile" accept=".xlsx, .xls, .csv" required>
                            <div class="form-text text-secondary mt-2">Файл с результатами текущего потока программы.</div>
                        </div>
                        
                        <!-- 2. ПОЛЗУНОК ДЛЯ ГРАФИКА ТРЕНДА -->
                        <div class="mb-4">
                            <div class="form-check form-switch fs-6">
                                <input class="form-check-input" type="checkbox" id="enableTrendToggle" name="isTrendEnabled" value="true" onchange="toggleTrendBox()">
                                <label class="form-check-label" for="enableTrendToggle">Рассчитать тренд удовлетворенности</label>
                            </div>
                        </div>

                        <!-- 3. ИСТОРИЧЕСКИЕ ФАЙЛЫ (Скрыто по умолчанию) -->
                        <div class="mb-4 trend-upload-box" id="trendFilesContainer">
                            <label for="historyFiles" class="form-label text-info">Исторические данные (для тренда)</label>
                            <!-- Обрати внимание на атрибут multiple - он позволяет выбрать сразу несколько файлов -->
                            <input class="form-control form-control-dark" type="file" id="historyFiles" name="historyFiles" multiple accept=".xlsx, .xls, .csv">
                            <div class="form-text text-secondary mt-2">
                                Выделите несколько Excel-файлов прошлых потоков. Даты будут определены автоматически.
                            </div>
                        </div>

                        <!-- 4. ВЫБОР ИИ-МОДЕЛИ -->
                        <div class="mb-5">
                            <label for="providerName" class="form-label">Вычислительная ИИ-модель</label>
                            <select class="form-select form-select-lg form-select-dark" id="providerName" name="providerName" required>
                                @if (ViewBag.Providers != null && ViewBag.Providers.Count > 0)
                                {
                                    foreach (var provider in ViewBag.Providers)
                                    {
                                        <option value="@provider">@provider</option>
                                    }
                                }
                                else
                                {
                                    <option value="groq">Groq (Оптимально)</option>
                                    <option value="gigachat">GigaChat</option>
                                    <option value="yandexgpt">YandexGPT</option>
                                }
                            </select>
                        </div>
                        
                        <!-- КНОПКА ОТПРАВКИ -->
                        <button type="submit" class="btn btn-official btn-lg w-100 py-3" id="analyzeBtn" onclick="return validateAndSubmit()">
                            <i class="bi bi-bar-chart-steps me-2"></i> Сгенерировать аналитику
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- ЛОАДЕР (Появляется при отправке) -->
    <div id="loader" class="mt-5" style="display:none;">
        <div class="spinner-border loader-spinner mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
        <h5 class="text-white">ИИ-агент обрабатывает данные...</h5>
        <p class="text-secondary">Это может занять от 5 до 15 секунд в зависимости от объема файлов.</p>
    </div>
</div>

<script>
    // Функция для показа/скрытия блока с дополнительными файлами
    function toggleTrendBox() {
        const toggle = document.getElementById('enableTrendToggle');
        const trendBox = document.getElementById('trendFilesContainer');
        const historyInput = document.getElementById('historyFiles');

        if (toggle.checked) {
            trendBox.style.display = 'block';
        } else {
            trendBox.style.display = 'none';
            // Очищаем выбранные файлы, если пользователь передумал
            historyInput.value = ''; 
        }
    }

    // Валидация и запуск лоадера
    function validateAndSubmit() {
        const mainFileInput = document.getElementById('uploadFile');
        
        // Если основной файл не выбран, браузер сам покажет стандартную ошибку (required)
        if (!mainFileInput.value) {
            return true; 
        }

        // Прячем форму, показываем красивую загрузку
        document.querySelector('.official-card').style.display = 'none';
        document.getElementById('loader').style.display = 'block';
        
        return true;
    }
</script>