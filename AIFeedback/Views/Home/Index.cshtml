@@model UploadViewModel

@{
    ViewData["Title"] = "Главная";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">ИИ-агент для анализа анкет</h3>
                </div>
                <div class="card-body">
                    <p class="lead">Загрузите Excel-файл с анкетами, и наш агент автоматически сформирует аналитическую справку и дашборд.</p>
                    <form asp-action="Process" asp-controller="Feedback" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="excelFile" class="form-label">Выберите файл (.xlsx)</label>
                            <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx,.xls" required>
                            <!-- Убираем asp-validation-for, так как IFormFile не поддерживает стандартную валидацию -->
                            @* <span asp-validation-for="ExcelFile" class="text-danger"></span> *@
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <span class="text-danger">@Model.ErrorMessage</span>
                            }
                        </div>
                        <div class="mb-3">
                            <label for="providerName" class="form-label">LLM-провайдер (необязательно)</label>
                            <input type="text" class="form-control" id="providerName" name="provider" placeholder="gigachat, groq, deepseek, ..." value="gigachat">
                            <small class="form-text text-muted">Оставьте пустым для использования провайдера по умолчанию.</small>
                        </div>
                        <button type="submit" class="btn btn-primary">Запустить анализ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>