@{
    ViewData["Title"] = "Учебная Аналитика - Загрузка анкет";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Анализатор учебных анкет (ИИ-Агент)</h1>
            <p class="lead mb-5">
                Загрузите выгрузку анкет слушателей (Excel) для автоматического формирования аналитической справки и дашборда.
            </p>

            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <!-- Форма отправляет файл на наш AnalyzerController -->
                    <form id="uploadForm" asp-controller="Analyzer" asp-action="ProcessFile" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="uploadFile" class="form-label fw-bold">Выберите файл .xlsx или .csv</label>
                            <input class="form-control form-control-lg" type="file" id="uploadFile" name="uploadFile" accept=".xlsx, .xls, .csv" required>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                <i class="bi bi-play-fill"></i> Запустить анализ
                            </button>
                        </div>
                    </form>

                    <!-- Блок со спиннером загрузки (изначально скрыт) -->
                    <div id="loadingSpinner" class="mt-4" style="display: none;">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <h5 class="mt-3 text-muted">ИИ-агент анализирует данные...</h5>
                        <p class="text-small text-muted">Пожалуйста, подождите. Это может занять несколько минут.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Простой скрипт для отображения спиннера при отправке формы
        document.getElementById('uploadForm').addEventListener('submit', function (e) {
            var fileInput = document.getElementById('uploadFile');
            if (fileInput.files.length > 0) {
                document.getElementById('submitBtn').style.display = 'none';
                document.getElementById('loadingSpinner').style.display = 'block';
            }
        });
    </script>
}