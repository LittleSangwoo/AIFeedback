@model DashboardViewModel
@using System.Globalization

<style>
    /* Dark Theme Dashboard Styles */
    body { background-color: #0f0f13 !important; color: #e0e0e0 !important; }
    .dashboard-header { border-bottom: 1px solid rgba(124, 77, 255, 0.2); padding-bottom: 1rem; }
    .stat-card {
        background: #1e1e2d; border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px; transition: transform 0.2s;
    }
    .stat-card:hover { transform: translateY(-5px); border-color: rgba(124, 77, 255, 0.4); }
    .chart-card {
        background: #1e1e2d; border: 1px solid rgba(255,255,255,0.05); border-radius: 16px;
    }
    .text-accent { color: #b388ff !important; }
    .btn-export-pdf { background-color: transparent; border: 1px solid #ff5252; color: #ff5252; border-radius: 8px; }
    .btn-export-pdf:hover { background-color: #ff5252; color: white; }
    .btn-export-word { background-color: transparent; border: 1px solid #448aff; color: #448aff; border-radius: 8px; }
    .btn-export-word:hover { background-color: #448aff; color: white; }
    
    .ai-insights-card {
        background: linear-gradient(145deg, #1a1a2e 0%, #161625 100%);
        border: 1px solid #7c4dff; border-radius: 16px;
        box-shadow: 0 0 20px rgba(124, 77, 255, 0.15);
    }
    .badge-high { background-color: #ff5252; color: white; }
    .badge-medium { background-color: #ffd600; color: #000; }

    /* Контейнер для жесткого контроля высоты графиков */
    .chart-wrapper {
        position: relative;
        height: 260px; /* Идеальная высота для дашборда */
        width: 100%;
    }
    
    /* Стили для печати (Светлая тема для PDF) */
    @@media print {
        body { background-color: white !important; color: black !important; }
        .btn, form, header, footer { display: none !important; }
        .stat-card, .chart-card, .ai-insights-card { background: white !important; border: 1px solid #ccc !important; box-shadow: none !important; break-inside: avoid; }
        .text-accent, .text-secondary { color: black !important; }
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
        <h2 class="fw-bold"><i class="bi bi-bar-chart-fill text-accent me-2"></i> Дашборд: <span class="text-white">@Model.ProgramName</span></h2>
        <!-- КРИТЕРИЙ 3.4: Экспорт в PDF и Word -->
        <div class="d-flex gap-2">
            <button class="btn btn-export-pdf px-4 py-2" onclick="window.print()"><i class="bi bi-file-pdf"></i> PDF</button>
            <a asp-controller="Report" asp-action="DownloadWord" asp-route-id="@Model.Id" class="btn btn-export-word px-4 py-2"><i class="bi bi-file-word"></i> Word</a>
        </div>
    </div>

