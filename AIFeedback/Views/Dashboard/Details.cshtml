@@model DashboardViewModel

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Дашборд программы: @Model.ProgramName</h2>
        <!-- КРИТЕРИЙ 3.4: Экспорт в PDF и Word -->
        <div>
            <button class="btn btn-outline-danger" onclick="window.print()"><i class="bi bi-file-pdf"></i> Экспорт в PDF (Дашборд)</button>
            <a asp-controller="Report" asp-action="DownloadWord" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-file-word"></i> Скачать Word-отчет</a>
        </div>
    </div>

    <!-- Основные метрики -->
    <div class="row text-center mb-4">
        <div class="col-md-3"><div class="card p-3 shadow-sm bg-light"><h5>Общая удовлетворенность</h5><h2 class="text-primary">@Model.OverallSatisfaction / 10</h2></div></div>
        <div class="col-md-3"><div class="card p-3 shadow-sm"><h5>Вовлеченность</h5><h2 class="text-success">@Model.EngagementYesPercent%</h2></div></div>
        <div class="col-md-3"><div class="card p-3 shadow-sm"><h5>Сентимент (Позитив)</h5><h2 class="text-info" id="sentimentPos">...</h2></div></div>
    </div>

    <!-- КРИТЕРИЙ 1.5: 5 ГРАФИКОВ -->
    <div class="row mb-4">
        <!-- 1. Линейчатая диаграмма (Средние баллы) -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="card-title">Средние баллы по 4 критериям</h5>
                <canvas id="barChart"></canvas>
            </div>
        </div>
        <!-- 2. Спайдер-график (Профиль удовлетворенности) -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="card-title">Профиль удовлетворенности</h5>
                <canvas id="radarChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- 4. Столбчатая диаграмма (Распределение оценок) -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="card-title">Распределение общей оценки</h5>
                <canvas id="distributionChart"></canvas>
            </div>
        </div>
        <!-- 5. График тренда (Динамика по потокам) -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="card-title">Тренд удовлетворенности (История)</h5>
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 3. Тепловая карта корреляций -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm p-3">
                <h5 class="card-title">Тепловая карта: Корреляция критериев</h5>
                <p class="text-muted small">Отражает зависимость общей оценки от конкретных критериев.</p>
                <div id="heatmapContainer" class="d-flex justify-content-center">
                    <!-- Заполняется через JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- КРИТЕРИЙ 1.4: Выводы ИИ -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm p-4 bg-white border-primary">
                <h4 class="text-primary"><i class="bi bi-robot"></i> ИИ-анализ и Рекомендации</h4>
                <div id="aiInsightsContainer"></div>
            </div>
        </div>
    </div>
</div>

<!-- Подключаем Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // 1. Получаем данные из C# Модели
    const averages = [@Model.UsefulnessAvg, @Model.PracticalityAvg, @Model.AvailabilityAvg, @Model.EngagementYesPercent];
    const labels = ['Полезность', 'Практика', 'Доступность', 'Взаимодействие с КУ'];
    
    // Парсим JSON, который сгенерировал ИИ (твоя работа)
    const aiData = @Html.Raw(Model.AiAnalysis.Conclusions ?? "{}");
    
    // Заполняем данные на странице
    if(aiData.sentiment) {
        document.getElementById('sentimentPos').innerText = aiData.sentiment.positivePercent + '%';
    }

    // РЕНДЕР ГРАФИКОВ
    // 1. Bar Chart (Средние)
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'Средний балл', data: averages, backgroundColor: 'rgba(54, 162, 235, 0.6)' }] },
        options: { scales: { y: { beginAtZero: true, max: 10 } } }
    });

    // 2. Radar Chart (Спайдер)
    new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: { labels: labels, datasets: [{ label: 'Баллы', data: averages, backgroundColor: 'rgba(255, 99, 132, 0.4)', borderColor: 'rgba(255, 99, 132, 1)' }] },
        options: { scales: { r: { min: 0, max: 10 } } }
    });

    // 4. Распределение (Берем из ViewModel - напарница должна посчитать это в парсере)
    const distData = [@Model.Dist1to3, @Model.Dist4to7, @Model.Dist8to10];
    new Chart(document.getElementById('distributionChart'), {
        type: 'bar',
        data: { labels: ['1-3 (Низкая)', '4-7 (Средняя)', '8-10 (Высокая)'], datasets: [{ label: 'Кол-во слушателей', data: distData, backgroundColor: ['#dc3545', '#ffc107', '#198754'] }] }
    });

    // 5. График тренда (История из ViewModel.HistoryData)
    // Здесь подставь массив из прошлых сессий
    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: { labels: ['Поток 1', 'Поток 2', 'Поток 3', 'Текущий поток'], datasets: [{ label: 'Общая удовлетворенность', data: [8.1, 8.5, 8.2, @Model.OverallSatisfaction], borderColor: '#0d6efd', tension: 0.3 }] },
        options: { scales: { y: { min: 0, max: 10 } } }
    });

    // Отрисовка ИИ-рекомендаций
    const insightsHtml = aiData.recommendations.map(r => 
        `<div class="mb-3">
            <strong><span class="badge bg-${r.priority === 'High' ? 'danger' : 'warning'}">${r.priority}</span> ${r.action}</strong><br/>
            <small class="text-muted"><i class="bi bi-graph-up"></i> Обоснование: ${r.dataProof}</small>
        </div>`
    ).join('');
    document.getElementById('aiInsightsContainer').innerHTML = insightsHtml;

    // Вспомогательный код для Heatmap (Тепловой карты) на CSS/HTML 
    // Напарница должна передать матрицу корреляций (например 4x4)
    // ...
</script>

<style>
    /* Прячем кнопки при экспорте в PDF */
    @@media print {
        .btn, form, header, footer { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
    }
</style>