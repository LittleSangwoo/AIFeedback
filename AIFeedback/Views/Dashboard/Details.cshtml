    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Средние баллы по критериям</h4>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Полезность</span>
                    <span class="badge bg-primary">@Model.UsefulnessAvg.ToString("F2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Доступность</span>
                    <span class="badge bg-primary">@Model.AvailabilityAvg.ToString("F2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Практико-ориентированность</span>
                    <span class="badge bg-primary">@Model.PracticalityAvg.ToString("F2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Взаимодействие с КУ</span>
                    <span class="badge bg-primary">@Model.InteractionAvg.ToString("F2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Вовлеченность (%)</span>
                    <span class="badge bg-success">@Model.EngagementYesPercent.ToString("F1")%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between fw-bold">
                    <span>Общая удовлетворённость</span>
                    <span class="badge bg-secondary">@Model.OverallSatisfaction.ToString("F2")</span>
                </li>
            </ul>
        </div>

        <div class="col-md-6">
            <h4>Сентимент-анализ</h4>
            <div class="progress" style="height: 30px;">
                <div class="progress-bar bg-success" style="width: @Model.AiAnalysis?.Sentiment?.PositivePercent%;">
                    @Model.AiAnalysis?.Sentiment?.PositivePercent.ToString("F0")% позитивных
                </div>
                <div class="progress-bar bg-warning" style="width: @Model.AiAnalysis?.Sentiment?.NeutralPercent%;">
                    @Model.AiAnalysis?.Sentiment?.NeutralPercent.ToString("F0")% нейтральных
                </div>
                <div class="progress-bar bg-danger" style="width: @Model.AiAnalysis?.Sentiment?.NegativePercent%;">
                    @Model.AiAnalysis?.Sentiment?.NegativePercent.ToString("F0")% негативных
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h4>Топ-тем</h4>
            @if (Model.AiAnalysis?.TopTopics != null && Model.AiAnalysis.TopTopics.Any())
            {
                <ul>
                    @foreach (var topic in Model.AiAnalysis.TopTopics)
                    {
                        <li><strong>@topic.Name</strong> – упоминаний: @topic.MentionCount</li>
                    }
                </ul>
            }
            else
            {
                <p>Нет данных.</p>
            }
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h4>Рекомендации</h4>
            @if (Model.AiAnalysis?.Conclusions != null && Model.AiAnalysis.Conclusions.Any())
            {
                <ul>
                    @foreach (var conclusion in Model.AiAnalysis.Conclusions)
                    {
                        <li><strong>@conclusion.Text</strong> – @conclusion.Recommendation (Приоритет: @conclusion.Priority)</li>
                    }
                </ul>
            }
            else
            {
                <p>Нет рекомендаций.</p>
            }
        </div>
    </div>

