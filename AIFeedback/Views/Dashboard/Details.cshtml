            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true, max: 10, ticks: { stepSize: 1 } } },
            plugins: { legend: { display: false } }
        }
    });

    // --- Radar Chart ---
    new Chart(document.getElementById('radarChart').getContext('2d'), {
        type: 'radar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Профиль',
                data: averages,
                backgroundColor: 'rgba(124, 77, 255, 0.2)',
                borderColor: '#7c4dff',
                pointBackgroundColor: '#b388ff',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                r: {
                    min: 0,
                    max: 10,
                    ticks: { stepSize: 2 },
                    grid: { color: 'rgba(255,255,255,0.1)' },
                    angleLines: { color: 'rgba(255,255,255,0.1)' }
                }
            }
        }
    });

    // --- Distribution Chart ---
    new Chart(document.getElementById('distributionChart').getContext('2d'), {
        type: 'bar',
        data: {
            labels: ['1-3 (Низкая)', '4-7 (Средняя)', '8-10 (Высокая)'],
            datasets: [{
                label: 'Кол-во слушателей',
                data: distData,
                backgroundColor: ['#ff5252', '#ffd600', '#00e676'],
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true, ticks: { stepSize: 5 } } },
            plugins: { legend: { display: false } }
        }
    });

    // --- Trend Chart ---
    new Chart(document.getElementById('trendChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: ['Поток 1', 'Поток 2', 'Поток 3', 'Текущий поток'],
            datasets: [{
                label: 'Общая удовлетворенность',
                data: [8.1, 8.5, 8.2, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallSatisfaction))],
                borderColor: '#00e5ff',
                backgroundColor: 'rgba(0, 229, 255, 0.1)',
                fill: true,
                tension: 0.4,
                borderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { min: 0, max: 10 } },
            plugins: { legend: { labels: { color: '#a0a0b0' } } }
        }
    });

    // ==============================================
    // 6. ТЕПЛОВАЯ КАРТА (корреляция)
    // ==============================================
    function renderHeatmap() {
        // Здесь можно подставить реальную матрицу корреляции из модели, если она есть
        const corrMatrix = [
            [1.0, 0.6, 0.4, 0.8],
            [0.6, 1.0, 0.5, 0.3],
            [0.4, 0.5, 1.0, 0.7],
            [0.8, 0.3, 0.7, 1.0]
        ];

        let html = '<div class="heatmap-grid">';
        html += '<div></div>' + labels.map(l => `<div class="heatmap-label-top">${l.substring(0, 5)}.</div>`).join('');

        for (let i = 0; i < 4; i++) {
            html += `<div class="heatmap-label">${labels[i].substring(0, 5)}.</div>`;
            for (let j = 0; j < 4; j++) {
                const val = corrMatrix[i][j];
                const alpha = val.toFixed(2);
                html += `<div class="heatmap-cell" style="background-color: rgba(13, 110, 253, ${alpha}); color: ${val > 0.6 ? 'white' : 'black'}">${val}</div>`;
            }
        }
        html += '</div>';
        document.getElementById('heatmapContainer').innerHTML = html;
    }
    renderHeatmap();

    // ==============================================
    // 7. ДОПОЛНИТЕЛЬНЫЕ СТИЛИ (объединены)
    // ==============================================
</script>

