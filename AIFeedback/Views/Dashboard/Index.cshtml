@@model List<DashboardViewModel>

@{
    ViewData["Title"] = "История анализов";
}

<div class="container mt-4">
    <h1 class="mb-4">История обработанных программ</h1>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Название программы</th>
                        <th>Дата анализа</th>
                        <th>Слушателей</th>
                        <th>Ср. удовлетворённость</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProgramName</td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.ListenerCount</td>
                            <td>@item.OverallSatisfaction.ToString("F2")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детали</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">Пока нет обработанных программ. Загрузите анкету на главной странице.</div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">← На главную</a>
</div>