@model UploadViewModel

@{
    ViewData["Title"] = "Учебная аналитика";
}

<style>
    /* Premium Dark Theme Styles */
    body {
        background-color: #0f0f13 !important;
        color: #e0e0e0 !important;
    }
    .hero-title {
        background: linear-gradient(135deg, #b388ff 0%, #7c4dff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
    .glass-card {
        background: rgba(30, 30, 40, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(124, 77, 255, 0.3);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 20px rgba(124, 77, 255, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card:hover {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 30px rgba(124, 77, 255, 0.3);
    }
    
    /* === ИСПРАВЛЕННЫЕ СТИЛИ ДЛЯ ИНПУТА ФАЙЛА === */
    .custom-file-input {
        background-color: #1a1a24 !important;
        border: 2px dashed #4527a0 !important;
        color: #ffffff !important; /* Принудительно делаем текст имени файла белым */
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .custom-file-input:focus, .custom-file-input:hover {
        border-color: #b388ff !important;
        background-color: #232332 !important;
        box-shadow: none !important;
        color: #ffffff !important;
    }
    
    /* Стилизуем саму кнопку "Обзор..." под темную тему */
    .custom-file-input::file-selector-button {
        background-color: #4527a0;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 0.375rem 1rem;
        margin-right: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
    }
    .custom-file-input::file-selector-button:hover {
        background-color: #651fff;
    }
    /* =========================================== */

    .btn-neon {
        background: linear-gradient(45deg, #651fff, #7c4dff);
        border: none;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        box-shadow: 0 4px 15px rgba(101, 31, 255, 0.4);
        transition: all 0.3s ease;
    }
    .btn-neon:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(101, 31, 255, 0.6);
        color: white;
    }
    .loader-pulse {
        color: #b388ff;
    }

    .custom-select-neon {
        background-color: #1a1a24;
        border: 1px solid #4527a0;
        color: #fff;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .custom-select-neon:focus {
        border-color: #b388ff;
        box-shadow: 0 0 15px rgba(124, 77, 255, 0.3);
        background-color: #232332;
        color: #fff;
    }
</style>

<div class="container text-center mt-4">
    <h1 class="display-4 hero-title mb-3">Аналитика образовательных программ</h1>
    <p class="lead text-secondary mb-5">Загрузите выгрузку анкет, и ИИ-агент подготовит отчет за несколько секунд.</p>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card glass-card">
                <div class="card-body p-5">
                    <!-- Форма отправки оставлена без изменений для бэкенда -->
                    <form asp-controller="Analyzer" asp-action="ProcessFile" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="uploadFile" class="form-label text-start w-100 fw-bold" style="color: #b388ff;">Файл выгрузки (Excel)</label>
                            <input class="form-control form-control-lg custom-file-input p-3" type="file" id="uploadFile" name="uploadFile" accept=".xlsx, .xls, .csv" required>
                        </div>
                        
                        <button type="submit" class="btn btn-neon btn-lg w-100 py-3" id="analyzeBtn" onclick="showLoader()">
                            <i class="bi bi-magic me-2"></i> Сгенерировать аналитику
                        </button>

                        <!-- Поле выбора нейросети -->
                        <div class="mb-4 mt-4 text-start">
                            <label for="providerName" class="form-label fw-bold" style="color: #b388ff;">Выберите ИИ-модель</label>
                            <select class="form-select form-select-lg p-3 custom-select-neon" id="providerName" name="providerName" required>
                                @if (ViewBag.Providers != null && ViewBag.Providers.Count > 0)
                                {
                                    foreach (var provider in ViewBag.Providers)
                                    {
                                        <option value="@provider">@provider</option>
                                    }
                                }
                                else
                                {
                                    <!-- Запасной вариант, если ViewBag пустой -->
                                    <option value="groq">Groq</option>
                                    <option value="gigachatApi">GigaChat</option>
                                    <option value="yandexgpt">YandexGPT</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Обновленный лоадер -->
    <div id="loader" class="mt-5" style="display:none;">
        <div class="spinner-grow loader-pulse" style="width: 3rem; height: 3rem;" role="status"></div>
        <h5 class="mt-3" style="color: #b388ff;">ИИ-агент анализирует тексты...</h5>
        <p class="text-secondary">Пожалуйста, подождите (до 15 сек). Мы выявляем скрытые инсайты.</p>
    </div>
</div>

<script>
    function showLoader() {
        if(document.getElementById('uploadFile').value) {
            document.getElementById('analyzeBtn').style.display = 'none';
            document.getElementById('loader').style.display = 'block';
        }
    }
</script>